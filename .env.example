# ===== Supabase (Project Settings → API) =====
# Ommaviy qiymatlar — brauzerga chiqishi mumkin
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# MAXFIY! Faqat serverda ishlatiladi (checkout, rate limit). Hech qachon NEXT_PUBLIC_ bilan boshlamang
# va gitga qo'shmang. Vercel'da Environment Variables bo'limiga qo'shing.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Saytning to'liq manzili (sitemap, OG, email havolalari uchun)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MAXFIY! Cron (kechki Telegram hisobot, rejalashtirilgan xabarlar) uchun tasodifiy uzun satr.
# Vercel uni cron so'roviga "Authorization: Bearer ..." sifatida o'zi qo'shadi.
CRON_SECRET=

# Telegram bot tokeni bu yerda EMAS: Ega uni admin panel -> Xabarlar oynasida kiritadi va u faqat bazada turadi.

# ===== To'lov provayderlari (ixtiyoriy, hozircha ulanmagan) =====
# Click / Payme integratsiyasi uchun merchant hisob kerak. Kalitlar bo'lsa ham, src/lib/payments
# dagi provayder moduli yozilmaguncha checkout'da ko'rinmaydi.
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# CLICK_SECRET_KEY=
# PAYME_MERCHANT_ID=
# PAYME_SECRET_KEY=
